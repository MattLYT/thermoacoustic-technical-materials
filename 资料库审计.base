filters:
  and:
    - file.ext == "md"
    - file.basename != "README"
    - or:
        - file.folder == "相关资料"
        - file.folder == "相关资料/索引"
formulas:
  role: if(file.folder == "相关资料/索引", "索引清册", if(file.basename == "文献整理入口", "文献导航", if(file.basename == "专业名词与分类规则", "分类规则", "待归类")))
  lifecycle: if(file.folder == "相关资料/索引" || file.basename == "文献整理入口" || file.basename == "专业名词与分类规则", "保留", "待审计")
  evidence: if(file.folder == "相关资料/索引", "来源状态与清册", if(file.basename == "文献整理入口", "资料导航", if(file.basename == "专业名词与分类规则", "分类边界", "待判断")))
properties:
  formula.role:
    displayName: 角色
  formula.lifecycle:
    displayName: 生命周期
  formula.evidence:
    displayName: 证据层
  file.folder:
    displayName: 归档目录
  file.name:
    displayName: 文件
  file.mtime:
    displayName: 最近修改
  file.links:
    displayName: 出链
  file.backlinks:
    displayName: 入链
views:
  - type: table
    name: 当前入口与分类规则
    groupBy:
      property: role
      direction: ASC
    filters:
      and:
        - formula.lifecycle == "保留"
    order:
      - formula.role
      - file.name
      - file.folder
      - formula.evidence
      - file.mtime
      - file.links
      - file.backlinks
  - type: table
    name: 待审计文件
    filters:
      and:
        - formula.lifecycle == "待审计"
    order:
      - file.name
      - file.folder
      - file.mtime
